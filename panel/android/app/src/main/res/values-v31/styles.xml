<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 o mas: la pantalla de inicio la pinta el sistema con este fondo -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_fondo</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_g</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_fondo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_fondo</item>
    </style>
</resources>
