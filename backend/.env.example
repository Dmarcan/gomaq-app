# Variables de entorno del backend (API y worker). Copiar a backend/.env y completar.
# Nunca versionar valores reales: en Railway viven en las variables de cada servicio.
# Las variables opcionales van comentadas con su valor por defecto; descomentar solo para cambiarlas.
# Tabla completa con el servicio donde va cada una: docs/DESPLIEGUE.md.

# ---------------------------------------------------------------------------
# Obligatorias de la API (server.js no arranca si falta alguna)
# ---------------------------------------------------------------------------

# Conexion a PostgreSQL. En Railway es una referencia al servicio Postgres.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/gomaq

# Secreto de firma de la sesion. En NODE_ENV=production se rechaza si tiene menos de 32 caracteres,
# parece un valor de ejemplo o repite casi un solo caracter. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generar-uno-largo-y-aleatorio

# Supabase Storage (fotos de evidencia, PDF de guias y facturas, documentos de equipos).
SUPABASE_URL=https://tu-proyecto.supabase.co
# Clave de servicio (service role) del proyecto. Es un secreto: solo en el servidor.
SUPABASE_SERVICE_KEY=clave-de-servicio-de-supabase

# ---------------------------------------------------------------------------
# Servidor HTTP (opcionales)
# ---------------------------------------------------------------------------

# Puerto de escucha. Railway lo define solo.
# PORT=3000

# En "production" se activan las validaciones estrictas de JWT_SECRET y el modo produccion de las dependencias.
# Los Dockerfile ya lo fijan.
# NODE_ENV=production

# Saltos de proxy delante de la API, para que el limite de intentos de login cuente por la IP real.
# Sin definir solo se confia en loopback. En Railway: 1.
# TRUST_PROXY=1

# Fuerza la cabecera que obliga a pedir todo por HTTPS (upgrade-insecure-requests) fuera de Railway,
# que ya la activa sola. Solo con "1".
# FORZAR_HTTPS=1

# Origenes extra permitidos por CORS, separados por coma. Vacio = solo mismo origen (lo normal: el panel
# se sirve desde este backend y las apps moviles son nativas). Util para `flutter run -d chrome`.
# CORS_ORIGENES=http://localhost:8080

# URL publica del panel, para el enlace del correo "cuenta aprobada" y de los codigos de cuenta.
# Sin ella se usa https://$RAILWAY_PUBLIC_DOMAIN; sin ninguna de las dos el correo sale sin enlace.
# PANEL_URL=https://panel.ejemplo.cl

# ---------------------------------------------------------------------------
# Base de datos (opcionales)
# ---------------------------------------------------------------------------

# Conexion del rol dueno del esquema, para los scripts de operacion (migrar, cargas, retencion).
# Si falta, los scripts usan DATABASE_URL. Permite que la API corra con el rol limitado gomaq_app.
# DATABASE_URL_MIGRACION=postgresql://dueno:clave@localhost:5432/gomaq

# Espera maxima (ms) por una conexion del pool.
# DB_CONNECT_TIMEOUT_MS=5000
# Una consulta que pasa de esto (ms) se cancela en el servidor; 0 lo desactiva.
# DB_STATEMENT_TIMEOUT_MS=30000
# Una transaccion abierta sin actividad libera sus bloqueos tras estos ms.
# DB_IDLE_TX_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Sesiones (opcional)
# ---------------------------------------------------------------------------

# Con "0" el login vuelve al JWT firmado de 12 h en vez de la sesion guardada en la base (interruptor de vuelta atras).
# SESIONES_EN_BASE=0

# ---------------------------------------------------------------------------
# Supabase Storage: buckets y plazo (opcionales)
# ---------------------------------------------------------------------------

# Bucket de fotos de evidencia de las ordenes de trabajo.
# SUPABASE_BUCKET=evidencias-ot
# Bucket de PDF de guias y facturas.
# SUPABASE_BUCKET_DOCUMENTOS=documentos-gomaq
# Bucket de documentos de equipos.
# SUPABASE_BUCKET_EQUIPOS=equipos-gomaq
# Plazo (ms) de cada llamada a Storage.
# SUPABASE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Avisos: worker, correo y push
# ---------------------------------------------------------------------------

# Con "0" la API no arranca su propio worker de notificaciones (en Railway lo corre el servicio
# gomaq-worker). Sin la variable, el worker corre dentro de la API (desarrollo local y CI).
# NOTIFICACIONES_EN_PROCESO=0

# Filas que el worker toma por ciclo.
# NOTIF_LOTE=5
# Plazo (ms) de envio de un aviso.
# NOTIF_TIMEOUT_MS=15000
# Plazo (ms) de un correo que lleva fotos.
# NOTIF_TIMEOUT_FOTOS_MS=60000

# Resend (correo de factura, cuenta aprobada y codigos de cuenta). Obligatoria para que salgan correos;
# sin ella el aviso falla con un motivo visible en Notificaciones. Va en la API y en el worker.
RESEND_API_KEY=
# Remitente, por ejemplo: GOMAQ <avisos@dominio-verificado.cl>. El worker usa onboarding@resend.dev si falta
# (modo de pruebas de Resend: solo entrega a la cuenta duena de la clave).
CORREO_REMITENTE=onboarding@resend.dev
# Direccion unica (sin nombre ni comas) a la que responden los clientes; va como reply_to. Opcional.
CORREO_CONTACTO=

# Enciende el encolado de avisos push desde la API. Solo con "1". Activar despues de desplegar el
# worker con FCM_CUENTA_SERVICIO. Va en la API.
# PUSH_HABILITADO=1
# Cuenta de servicio de Firebase (JSON completo en base64) para enviar push por FCM. Secreto: solo
# en el worker. Sin ella los push quedan esperando.
# FCM_CUENTA_SERVICIO=

# Borrado diario de datos personales vencidos (notificaciones, solicitudes rechazadas, sesiones y
# codigos de cuenta). Corre en el worker; solo con "1". Plazos en backend/src/utils/retencion.js.
# RETENCION_ACTIVA=1

# ---------------------------------------------------------------------------
# Mapa y hora estimada de llegada (opcionales)
# ---------------------------------------------------------------------------

# Llave de OpenRouteService (plan gratuito de HeiGIT), para la hora estimada de llegada y el buscador
# de direcciones. Se crea en https://account.heigit.org. Vacia = la hora estimada es una aproximacion en
# linea recta y el buscador de direcciones queda sin servicio (sin verificar el comportamiento exacto). Va solo en la API; nunca en el panel, en terreno ni en git.
ORS_API_KEY=
# URL base de OpenRouteService.
# ORS_BASE_URL=https://api.heigit.org/openrouteservice
# URL base del geocodificador (Pelias de HeiGIT).
# PELIAS_BASE_URL=https://api.heigit.org/pelias/v1

# ---------------------------------------------------------------------------
# Solo pruebas y migraciones (opcionales)
# ---------------------------------------------------------------------------

# Habilita las pruebas de escritura, que crean y borran datos. Solo contra una base local.
# GOMAQ_TEST_ESCRITURA=1
# URL de una API en marcha para las pruebas de extremo a extremo; sin ella se omiten.
# GOMAQ_TEST_URL=http://localhost:3000
# Clave con que las pruebas de extremo a extremo inician sesion (por defecto la de la semilla local).
# GOMAQ_TEST_PASSWORD=
# Host adicional (aparte de localhost) donde se permite correr pruebas con base.
# GOMAQ_TEST_HOST_PERMITIDO=
# Version base y fixture de scripts/probar_migraciones_con_datos.js (por defecto 042 y
# db/scripts/fixture_migraciones_base.sql).
# MIGRACIONES_VERSION_BASE=042
# MIGRACIONES_FIXTURE=

# ---------------------------------------------------------------------------
# Definidas por la plataforma (no declarar a mano)
# ---------------------------------------------------------------------------
# RAILWAY_ENVIRONMENT_NAME   Railway la define en cada despliegue; activa la politica HTTPS.
# RAILWAY_PUBLIC_DOMAIN      Dominio publico del servicio; respaldo de PANEL_URL.
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS   Segundos de gracia al detener el worker (.railway/railway.ts); no lo lee el codigo.
# FIREBASE_API_KEY, FIREBASE_APP_ID, FIREBASE_MESSAGING_SENDER_ID, FIREBASE_PROJECT_ID, FIREBASE_VAPID_KEY
#   Configuracion publica de Firebase: no las lee el backend, son argumentos de build del Dockerfile
#   para el panel web (variables del servicio gomaq-app en Railway).
