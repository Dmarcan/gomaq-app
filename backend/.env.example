PORT=3000
DATABASE_URL=postgresql://gomaq_user:changeme@localhost:5432/gomaq
JWT_SECRET=changeme-generar-uno-largo-y-aleatorio
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=changeme-service-role-key
SUPABASE_BUCKET=evidencias-ot

# Origenes permitidos para CORS, separados por coma. Vacio = solo mismo origen,
# que es lo normal: el panel se sirve desde este backend y la app movil es nativa.
# Util solo para desarrollo, ej: http://localhost:8080
CORS_ORIGENES=

# Servicio de rutas para la hora estimada de llegada (OpenRouteService, plan gratuito de HeiGIT:
# 2.000 consultas al dia). La llave se crea en https://account.heigit.org y se escribe AQUI y en las
# variables de Railway del servicio gomaq-app; nunca en el panel ni en la app de terreno ni en git.
# Vacia = el sistema usa una hora estimada aproximada (linea recta), sin llamar a ningun servicio.
ORS_API_KEY=
